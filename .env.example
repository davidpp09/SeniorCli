# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.

# Frente 2 - proveedor de modelo. La primera implementacion es DeepSeek,
# pero el nucleo solo conoce el trait ModelProvider.
SENIOR_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Nivel de logs: error | warn | info | debug | trace
SENIOR_LOG=info
